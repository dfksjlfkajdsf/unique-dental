# ─────────────────────────────────────────────
# Unique Dental & Implant Center – Frontend Env
# Copy this file to .env and fill in your values.
# NEVER commit .env to git!
# ─────────────────────────────────────────────

# ── API ──────────────────────────────────────
VITE_API_URL=http://localhost:5000/api/v1

# ── App Info ─────────────────────────────────
VITE_APP_NAME=Unique Dental & Implant Center
VITE_APP_URL=http://localhost:5173

# ── Google Maps ──────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Contact / Clinic Info ─────────────────────
VITE_CLINIC_PHONE=+977-XXXXXXXXXX
VITE_CLINIC_EMAIL=info@yourdomain.com
VITE_WHATSAPP_NUMBER=97XXXXXXXX

# ── Social Links ─────────────────────────────
VITE_FACEBOOK_URL=https://www.facebook.com/yourpage
VITE_INSTAGRAM_URL=https://www.instagram.com/yourpage

# ── Analytics ────────────────────────────────
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
